<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ThucHanh2" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ptit_red</item>
        <item name="colorPrimaryContainer">@color/ptit_red_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/ptit_blue</item>
        <item name="colorSecondaryContainer">@color/ptit_blue_light</item>
        <item name="colorTertiary">@color/ptit_orange</item>
        <item name="colorSurface">@color/background_card</item>
        <item name="colorSurfaceVariant">@color/input_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/input_stroke</item>
        <item name="android:colorBackground">@color/background_primary</item>
        <item name="android:statusBarColor">@color/ptit_red</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.ThucHanh2" parent="Base.Theme.ThucHanh2" />

    <!-- Button Styles -->
    <style name="PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/ptit_red</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="SecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/ptit_red</item>
        <item name="android:textColor">@color/ptit_red</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="DangerButton" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/status_unread</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- TextInputLayout Style -->
    <style name="CustomTextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/input_stroke_selector</item>
        <item name="boxBackgroundColor">@color/input_background</item>
        <item name="hintTextColor">@color/ptit_blue</item>
    </style>

    <!-- Card Style -->
    <style name="BookCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="cardBackgroundColor">@color/background_card</item>
    </style>

    <!-- Chip / Badge for status -->
    <style name="StatusBadge">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- FAB shape -->
    <style name="FabShape" parent="">
        <item name="cornerSize">16dp</item>
    </style>

    <!-- RatingBar Theme -->
    <style name="RatingBarTheme">
        <item name="colorControlNormal">@color/star_empty</item>
        <item name="colorControlActivated">@color/star_filled</item>
    </style>
</resources>
